# syntax=docker/dockerfile:1.7

# Local-debug image: identical to the top-level Dockerfile, plus
# traceroute/tcpdump for local network troubleshooting.
#
# ONLY used by docker-compose.local.yml for local testing. The published
# release image (built from the top-level Dockerfile, pushed to ACR) never
# includes these tools — keep that image minimal and non-root-only.
FROM rust:1.88-alpine AS builder

RUN apk add --no-cache build-base cmake perl

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN --mount=type=cache,id=rove-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=rove-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=rove-target,target=/app/target,sharing=locked \
    cargo build --release --locked \
    && cp /app/target/release/rove /tmp/rove \
    && cp /app/target/release/rove-hop /tmp/rove-hop \
    && cp /app/target/release/rove-relay /tmp/rove-relay

FROM alpine:3.22

RUN apk add --no-cache ca-certificates traceroute tcpdump libcap \
    && addgroup -S rove \
    && adduser -S -D -H -h /nonexistent -s /sbin/nologin -G rove rove \
    && setcap cap_net_raw+eip /usr/bin/tcpdump

COPY --from=builder /tmp/rove /usr/local/bin/rove
COPY --from=builder /tmp/rove-hop /usr/local/bin/rove-hop
COPY --from=builder /tmp/rove-relay /usr/local/bin/rove-relay

USER rove
WORKDIR /app

ENTRYPOINT ["/usr/local/bin/rove"]
CMD ["--config", "/etc/rove/config.toml"]
