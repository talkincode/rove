{
  "schema_version": 1,
  "version": 41,
  "egresses": {
    "egress-a": {
      "type": "upstream",
      "backend": {
        "kind": "http",
        "addr": "proxy-a.example:8443",
        "username": "up-a",
        "password": "pw-a-secret",
        "tls": true
      }
    },
    "egress-b": {
      "type": "upstream",
      "backend": {
        "kind": "socks5",
        "addr": "proxy-b.example:1080",
        "username": "up-b",
        "password": "pw-b-secret"
      }
    },
    "chain-x": {
      "type": "chain",
      "members": [
        {
          "id": "hop-1",
          "priority": 10,
          "backend": {
            "kind": "http",
            "addr": "hop1.example:8443",
            "username": "hop1-user",
            "password": "hop1-secret",
            "tls": true
          }
        },
        {
          "id": "hop-2",
          "priority": 20,
          "backend": {
            "kind": "socks5",
            "addr": "hop2.example:1080"
          }
        }
      ]
    }
  },
  "routing_policies": {
    "policy-main": {
      "routes": [
        { "selectors": ["block.example.com"], "action": { "type": "block" } },
        { "selectors": ["full:exact.example.com"], "action": { "type": "egress", "egress": "egress-a" } },
        { "selectors": ["keyword:sockshost"], "action": { "type": "egress", "egress": "egress-b" } },
        { "selectors": ["chain.example.com"], "action": { "type": "egress", "egress": "chain-x" } },
        { "selectors": ["direct.example.com"], "action": { "type": "direct" } },
        { "selectors": ["10.0.0.0/8"], "action": { "type": "egress", "egress": "egress-a" } },
        { "selectors": ["overlap.example.com"], "action": { "type": "egress", "egress": "egress-a" } },
        { "selectors": ["overlap.example.com"], "action": { "type": "block" } }
      ],
      "default_egress": "egress-b"
    },
    "policy-direct-default": {
      "routes": []
    },
    "policy-default-egress": {
      "routes": [
        { "selectors": ["denied.example.com"], "action": { "type": "block" } }
      ],
      "default_egress": "egress-a"
    }
  },
  "users": {
    "alice": {
      "password": "alice-login-secret",
      "up_rate": 1024,
      "down_rate": 2048,
      "max_connections": 4,
      "policy": "policy-main",
      "frontends": {
        "tuic": { "uuid": "11111111-1111-1111-1111-111111111111", "password": "alice-tuic-secret" }
      }
    },
    "dana": {
      "password": "dana-login-secret",
      "policy": "policy-direct-default"
    },
    "evan": {
      "password": "evan-login-secret",
      "policy": "policy-default-egress"
    }
  },
  "node_overrides": {
    "edge-1": {
      "egresses": {
        "egress-a": {
          "type": "upstream",
          "backend": {
            "kind": "http",
            "addr": "proxy-a-edge1.example:9000",
            "username": "up-a-edge1",
            "password": "pw-a-edge1-secret",
            "tls": true
          }
        }
      }
    }
  }
}
